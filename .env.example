# ODIN — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Nothing in this file is required to run Phase 1 (the foundation has no
# real backend calls yet) — it exists so src/lib/env.ts has a documented,
# validated contract before the booking API (Phase 4) starts reading it.

# Public site URL — used for canonical URLs, sitemap, and Open Graph tags.
# No default: must be set explicitly in every environment (localhost in dev,
# the real domain in production) so metadata is never silently wrong.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Not yet used by Phase 1, reserved for the booking flow (Phase 4) ---
# Booking persistence (concrete provider TBD — see ARCHITECTURE.md §15)
# DATABASE_URL=

# Transactional email for booking notifications (Resend/Postmark — TBD)
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=hello@odin-farm.example

# Where booking notifications are sent (MOCK contact address — see MOCK_DATA.md)
# BOOKING_NOTIFICATION_EMAIL=hello@odin-farm.example
