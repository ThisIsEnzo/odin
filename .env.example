# ODIN Phase 5C. Copy to .env.local for Next.js; never commit actual secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Explicit memory is allowed only outside production and only with console.
BOOKING_STORAGE=postgres
DATABASE_URL=
# Dedicated destructive integration DB, name must end in _test.
TEST_DATABASE_URL=
TEST_DATABASE_RESET=
# Required explicit real channels in production: line,whatsapp (comma-separated).
# Console is development-only and sends nothing externally.
BOOKING_NOTIFICATION_CHANNELS=console
# Generate at least 32 random characters; server-only scheduler bearer secret.
NOTIFICATION_PROCESS_SECRET=
# Comma-separated staff user/group IDs; maximum 10. No default destination.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_RECIPIENT_ID=
# Channel secret is not needed for outgoing messages; no webhook is implemented.
# Store it in your verified webhook receiver if using one for group discovery.
# WhatsApp Cloud API: approved BODY template with reference, part, details.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_STAFF_RECIPIENT=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# Set only after recipient opt-in and the exact template have been verified.
WHATSAPP_STAFF_OPT_IN_CONFIRMED=
# Default no live sends. Explicit flag is required by live notification test script.
LIVE_NOTIFICATION_TEST=
