{
  "name": "odin-web",
  "version": "0.1.0",
  "private": true,
  "description": "ODIN — Farm & Resort Experience near Pattaya. Marketing + request-to-book MVP.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:status": "node --import tsx scripts/database.ts status",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "backend:check": "node --import tsx scripts/check-config.ts",
    "notifications:test:live": "node --import tsx scripts/live-notification-test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.460.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.6",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
